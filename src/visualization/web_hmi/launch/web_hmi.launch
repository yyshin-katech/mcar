<?xml version="1.0"?>
<!--
  web_hmi launcher.

  Frontend URL (open in any browser on the same host):
    F1 telemetry (default):  http://localhost:8088/index_f1.html
    Existing dark UI:        http://localhost:8088/index.html
    Three.js + HD map:       http://localhost:8088/index_threejs.html
    F1 dash + Three.js:      http://localhost:8088/index_threejs_f1.html

  Override variant:
    roslaunch web_hmi web_hmi.launch variant:=default
    roslaunch web_hmi web_hmi.launch variant:=threejs
    roslaunch web_hmi web_hmi.launch variant:=threejs_f1
-->
<launch>
  <arg name="bag_dir"      default="$(env HOME)/bag_data"/>
  <arg name="ws_port"      default="9090"/>
  <arg name="http_port"    default="8088"/>
  <arg name="open_browser" default="true"/>
  <!-- variant: f1 | default | threejs | threejs_f1 -->
  <arg name="variant"      default="threejs_f1"/>
  <arg name="page"         default="$(eval {'f1':'index_f1.html','default':'index.html','threejs':'index_threejs.html','threejs_f1':'index_threejs_f1.html'}.get(arg('variant'), 'index.html'))"/>
  <!-- HD map shapefile dir. senario_shp_20260623 = 시흥 시범운행 맵 (UTM52N /
       EPSG:32652 → EPSG:5179 재투영은 브리지 안에서 수행). 11개 표준 레이어. -->
  <arg name="shp_scenario" default="senario_shp_20260623"/>
  <arg name="shp_mapdir"   default="$(find gps_system_localizer)/src/shp_map/$(arg shp_scenario)"/>
  <!-- f1 variant: single A2_LINK overlay on the F1 environment. Empty = disabled. -->
  <arg name="map_shp"      default="$(arg shp_mapdir)/A2_LINK.shp"/>
  <!-- threejs variant: full 11-layer shapefile dir. -->
  <arg name="threejs_mapdir" default="$(arg shp_mapdir)"/>
  <!-- Planned-route ribbon (global_nav_hmi). extract_route.py output, EPSG:5179. -->
  <arg name="route_json"   default="$(find web_hmi)/scripts/route_senario_20260623.json"/>
  <!-- Point cloud that percept cloud_indices index into. /percept_origin_rviz is
       the organized (1800×128) cloud used by this platform's perception stack;
       siheung_release uses /fusion_lidar_points (different ordering). -->
  <arg name="cloud_topic"  default="/percept_origin_rviz"/>

  <!-- 1. rosbridge WebSocket server -->
  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch">
    <arg name="port" value="$(arg ws_port)"/>
  </include>

  <!-- 2. JSON aggregator bridge — always on (threejs variant reuses /hmi/state). -->
  <node name="web_hmi_bridge"
        pkg="web_hmi"
        type="web_hmi_bridge.py"
        output="screen"
        required="true">
    <env name="PYTHONPATH"
         value="$(find pyqt_hmi)/scripts:$(env PYTHONPATH)"/>
    <param name="bag_dir" value="$(arg bag_dir)"/>
    <param name="map_shp" value="$(arg map_shp)"/>
  </node>

  <!-- 2b. Three.js bridge (Python) — map / shapefile only. /hmi/threejs/tracks
       is moved to the C++ node below; ~publish_tracks=false keeps Python from
       advertising or subscribing to the percept/cloud hot path. -->
  <node if="$(eval arg('variant') in ('threejs', 'threejs_f1'))"
        name="web_hmi_threejs_bridge"
        pkg="web_hmi"
        type="web_hmi_threejs_bridge.py"
        output="screen"
        required="true">
    <param name="mapdir" value="$(arg threejs_mapdir)"/>
    <!-- global_nav_hmi: pre-extracted planned-route JSON (latched on
         /hmi/threejs/route). The shipped file is the siheung senario route —
         swap it (extract_route.py) when running a different site. -->
    <param name="route_json" value="$(arg route_json)"/>
    <param name="publish_tracks" value="false"/>
  </node>

  <!-- 2c. Three.js tracks (C++) — percept → /hmi/threejs/tracks at 10 Hz. -->
  <node if="$(eval arg('variant') in ('threejs', 'threejs_f1'))"
        name="web_hmi_threejs_tracks_cpp"
        pkg="web_hmi"
        type="web_hmi_threejs_tracks_cpp"
        output="screen"
        required="true">
    <param name="cloud_topic" value="$(arg cloud_topic)"/>
  </node>

  <!-- 3. Static asset HTTP server -->
  <node name="web_hmi_server"
        pkg="web_hmi"
        type="web_server.py"
        output="screen"
        required="true">
    <param name="port" value="$(arg http_port)"/>
    <param name="web_dir" value="$(find web_hmi)/web"/>
    <param name="page" value="$(arg page)"/>
  </node>

  <!-- 4. Optional browser launch -->
  <node if="$(arg open_browser)"
        name="web_hmi_open_browser"
        pkg="web_hmi"
        type="open_browser.py"
        output="screen">
    <param name="port" value="$(arg http_port)"/>
    <param name="page" value="$(arg page)"/>
  </node>
</launch>
