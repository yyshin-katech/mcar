<?xml version="1.0" encoding="UTF-8"?>
<!--
  web_hmi_replay.launch — web_hmi(threejs_f1) 실행 + ~/bag_data bag 재생 (한 번에)

  bag 에는 web_hmi 출력 토픽(/hmi/*)까지 녹화돼 있다.
  기본 동작: bag 의 /hmi/* 표시 토픽을 그대로 재생 → 브라우저가 "녹화된 HMI" 를
  재현한다. 단 /hmi/bag(REC 플래그)·/client_count 만 /sink/* 로 돌려 자동 REC 표시·
  노이즈를 막는다. live 브리지도 /hmi/* 를 발행하므로 dual-publisher 이지만 녹화
  rate 가 우세해 재현된다(replay 확인 완료).
  ※ live 브리지가 재생성한 /hmi/* 만 보려면(새 브리지 로직 검증 등) 아래 <node>
    안의 /hmi/* remap 주석을 해제하면 bag 쪽 /hmi/* 가 전부 /sink/* 로 빠진다.

  사용법 (bag 는 ~/bag_data 안의 "파일명"만 전달):
    roslaunch web_hmi web_hmi_replay.launch bag:=2026-07-07-18-17-21_2026-07-07-18-17-22_0.bag

  옵션:
    bag_dir:=<dir>        bag 디렉토리 (기본 ~/bag_data)
    rate:=0.5             재생 배속 (기본 1.0)
    open_browser:=false   브라우저 자동 열기 끄기 (기본 true)
  ※ 횡단보도 퓨전 노드(can/crosswalk_ped_fusion.py)는 siheung 계열 전용이라 이
    브랜치엔 없다. 따라서 /katech_msg/crosswalk_ped_fusion 이 bag 에 녹화돼 있지
    않으면 횡단보도는 폴리곤만 표시되고 붉은 점멸/팝업은 뜨지 않는다.

  브라우저 URL: http://localhost:8088/index_threejs_f1.html
-->
<launch>
  <!-- bag: ~/bag_data 안의 파일명 (필수). 예) 2026-07-07-18-17-21_..._0.bag -->
  <arg name="bag"/>
  <arg name="bag_dir"      default="$(env HOME)/bag_data"/>
  <arg name="rate"         default="1.0"/>
  <arg name="open_browser" default="true"/>

  <!-- 1. web_hmi (threejs_f1) — rosbridge(9090) + 브리지 + 웹서버(8088) 재사용 -->
  <include file="$(find web_hmi)/launch/web_hmi.launch">
    <arg name="variant"      value="threejs_f1"/>
    <arg name="open_browser" value="$(arg open_browser)"/>
    <arg name="bag_dir"      value="$(arg bag_dir)"/>
  </include>

  <!-- 2. bag 재생 — 기본은 /hmi/bag·/client_count 만 /sink 로 remap(자동 REC/노이즈
          방지)하고, 나머지 /hmi/* 표시 토픽은 그대로 재생해 "녹화된 HMI" 를 재현한다.
          /localization/*, /obu/* 등 입력 토픽도 remap 안 함.
          아래 주석된 remap 들을 해제하면 bag 의 /hmi/* 를 전부 /sink 로 빼고, live
          브리지가 입력 토픽으로 재생성한 /hmi/* 만 보게 된다(브리지 로직 검증용). -->
  <node name="web_hmi_bag_player" pkg="rosbag" type="play" output="screen"
        args="--clock --loop --rate $(arg rate) $(arg bag_dir)/$(arg bag)">
    <!-- <remap from="/hmi/state"                  to="/sink/hmi_state"/> -->
    <!-- <remap from="/hmi/threejs/map"            to="/sink/hmi_threejs_map"/> -->
    <!-- <remap from="/hmi/threejs/tracks"         to="/sink/hmi_threejs_tracks"/> -->
    <!-- <remap from="/hmi/threejs/free_space"     to="/sink/hmi_threejs_free_space"/> -->
    <!-- <remap from="/hmi/threejs/traffic_lights" to="/sink/hmi_threejs_traffic_lights"/> -->
    <remap from="/hmi/bag"                    to="/sink/hmi_bag"/>
    <!-- <remap from="/hmi/diagnostics"            to="/sink/hmi_diagnostics"/> -->
    <!-- <remap from="/hmi/objects"                to="/sink/hmi_objects"/> -->
    <!-- <remap from="/hmi/popup"                  to="/sink/hmi_popup"/> -->
    <!-- <remap from="/hmi/topic_hz"               to="/sink/hmi_topic_hz"/> -->
    <!-- <remap from="/hmi/map"                    to="/sink/hmi_map"/> -->
    <!-- <remap from="/hmi/ego_pose"               to="/sink/hmi_ego_pose"/> -->
    <remap from="/client_count"               to="/sink/client_count"/>
  </node>
</launch>
