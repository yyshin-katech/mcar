/* Ioniq5 HMI · A-1 (Solid Top-down · Amber) — global stylesheet */

QWidget                       { color: #F4F5F7; background: #0E0F11; }

QFrame#topbar                 { background: #15171A; border-bottom: 1px solid #232830; }
QFrame#bottom                 { background: #15171A; border-top: 1px solid #232830; }

QFrame#leftPanel              { background: #15171A; border-right: 1px solid #232830; }
QFrame#rightPanel             { background: #15171A; border-left: 1px solid #232830; }
QFrame#stage                  { background: #0E0F11; }

QLabel[role="section"]        { color: #5A616B; font-size: 10px; padding: 10px 0; }
QLabel[role="brand"]          { color: #F4F5F7; font-size: 14px; font-weight: 600; }
QLabel[role="caption"]        { color: #8A9099; font-size: 11px; }
QLabel[role="stat-k"]         { color: #5A616B; font-size: 10px; }
QLabel[role="stat-v"]         { color: #F4F5F7; font-size: 22px; }
QLabel[role="stat-unit"]      { color: #5A616B; font-size: 10px; }
QLabel[role="clock"]          { color: #C8CCD2; font-size: 13px; }

QFrame[role="card"]           { background: #1C1F23; border: 1px solid #232830; border-radius: 10px; }
QFrame[role="chip"]           { background: #1C1F23; border: 1px solid #232830; border-radius: 6px; }

QPushButton                   { background: #1C1F23; border: 1px solid #232830; border-radius: 8px;
                                padding: 8px 14px; color: #F4F5F7; }
QPushButton:hover             { background: #232830; }
QPushButton[variant="primary"] { background: #FFB547; color: #1A1206; border: none; }
QPushButton[variant="primary"]:hover { background: #F59E2C; }
QPushButton[variant="danger"]  { background: #1C1F23; color: #F87171; border: 1px solid #3A2024; }
QPushButton[variant="danger"]:hover { background: #2A1418; }

QFrame[role="gear-cell"]      { background: transparent; border: 1px solid #232830; border-radius: 8px; }
QFrame[role="gear-cell"][active="true"] { background: #FFB547; border: none; }
QLabel[role="gear-text"]      { color: #C8CCD2; font-size: 18px; font-weight: 500; }
QLabel[role="gear-text"][active="true"] { color: #1A1206; }
