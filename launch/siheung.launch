<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <arg name="sweet_home" default="$(optenv HOME)" />

    <!-- 시흥시 VPN (SecuwaySSL) 자격증명·서버 — launch 가 직접 VPN 을 띄우지는 않음.
         다른 PC 셋업 시 ~/sslvpn/conf/client.info (vpn_ip / vpn_port) 와
         sudo ./SecuwaySSLU_client 실행 시 입력할 ID/PW 참조용. -->
    <arg name="vpn_server_ip"   value="27.101.133.111" />
    <arg name="vpn_server_port" value="443" />
    <arg name="vpn_id"          value="kanavi001" />
    <arg name="vpn_pass"        value="kanavI99!@#$" />

    <!-- MQTT broker 선택: test = 인터넷 테스트 서버, prod = 차량 사설망 실제 서버 (시흥시 VPN 필요) -->
    <!-- 기본 prod. 인터넷 테스트 시 mqtt_server:=test 로 override -->
    <!-- 예) roslaunch launch/siheung.launch mqtt_server:=test -->
    <arg name="mqtt_server" default="prod" />

    <!--   테스트 서버 (test) : 121.137.106.141 : 23312 / ut_adcp -->
    <arg name="mqtt_host_test" value="121.137.106.141" />
    <arg name="mqtt_port_test" value="23312" />
    <arg name="mqtt_user_test" value="ut_adcp" />
    <arg name="mqtt_pass_test" value="ut_adcp123!@#" />

    <!--   실제 서버 (prod) : 192.168.255.173 : 10044 / xcms-mtqq -->
    <arg name="mqtt_host_prod" value="192.168.255.173" />
    <arg name="mqtt_port_prod" value="10044" />
    <arg name="mqtt_user_prod" value="xcms-mtqq" />
    <arg name="mqtt_pass_prod" value="xcms123!" />

    <!-- 선택된 서버로 dispatch -->
    <arg name="mqtt_host" value="$(eval arg('mqtt_host_prod') if arg('mqtt_server')=='prod' else arg('mqtt_host_test'))" />
    <arg name="mqtt_port" value="$(eval arg('mqtt_port_prod') if arg('mqtt_server')=='prod' else arg('mqtt_port_test'))" />
    <arg name="mqtt_user" value="$(eval arg('mqtt_user_prod') if arg('mqtt_server')=='prod' else arg('mqtt_user_test'))" />
    <arg name="mqtt_pass" value="$(eval arg('mqtt_pass_prod') if arg('mqtt_server')=='prod' else arg('mqtt_pass_test'))" />

    <param name="EPSG" value="5179" />

    <!-- OBU UDP 수신 바인드. 기본 0.0.0.0(실제 네이티브 Ubuntu).
         WSL mirrored 테스트에서는 obu_bind_ip:=192.168.1.3 으로 override -->
    <arg name="obu_bind_ip"   default="0.0.0.0" />
    <arg name="obu_bind_port" default="9999" />

    <!-- J2735 TIM RX (OBU → PC, UDP 9999, SPaT 노드와 동일 포트 공유) -->
    <arg name="tim_topic"          default="/obu/tim" />
    <arg name="tim_pedes_topic"    default="/obu/v2x_pedes_assistance" />
    <arg name="go_ahead_topic"     default="/v2x/go_ahead" />
    <arg name="allow_raw_tim"      default="false" />
    <!-- 31=TIM. SPaT-path 진단 시에만 19 사용 -->
    <arg name="tim_target_msg_id"  default="31" />

    <!-- V2X RX (OBU → PC, UDP 9999) -->
    <node name="siheung_v2x_node"       type="siheung_v2x_node"     pkg="siheung_v2x"  respawn="true">
        <param name="bind_ip"   value="$(arg obu_bind_ip)" />
        <param name="bind_port" value="$(arg obu_bind_port)" />
    </node>

    <!-- J2735 TIM RX (OBU → PC, UDP 9999) → go_ahead / pedes_assist 토픽 -->
    <node name="j2735_TIM_rx_node" type="j2735_TIM_rx_node" pkg="siheung_v2x" output="screen">
        <param name="bind_ip"       value="$(arg obu_bind_ip)" />
        <param name="bind_port"     value="$(arg obu_bind_port)" />
        <param name="topic"         value="$(arg tim_topic)" />
        <param name="pedes_topic"   value="$(arg tim_pedes_topic)" />
        <param name="go_ahead_topic" value="$(arg go_ahead_topic)" />
        <param name="allow_raw_tim" value="$(arg allow_raw_tim)" />
        <param name="target_msg_id" value="$(arg tim_target_msg_id)" />
    </node>

    <!-- V2X TX BSM (PC → OBU, UDP 6666) -->
    <node name="bsm_tx_node"            type="bsm_tx_node"          pkg="siheung_v2x"  respawn="true" output="screen">
        <param name="enable_udp"        value="true" />
        <param name="vehicle_id"        value="EV01" />
    </node>

    <!-- V2X RX via MQTT (Cloud V2N → PC). mqtt_server arg 로 test/prod 전환 -->
    <node name="mqtt_spat_rx_node" type="mqtt_spat_rx_node" pkg="siheung_v2x"
          respawn="true" output="screen">
        <param name="broker_host"  value="$(arg mqtt_host)" />
        <param name="broker_port"  value="$(arg mqtt_port)" />
        <param name="username"     value="$(arg mqtt_user)" />
        <param name="password"     value="$(arg mqtt_pass)" />
        <param name="topic"        value="V2N/1321103202/trf_drct/spat" />
        <param name="client_id"    value="" />
        <param name="keepalive"    value="60" />
        <param name="qos"          value="0" />
        <param name="spat_topic"   value="/siheung_v2x/mqtt_spat" />
        <param name="verbose_first_msg" value="true" />
    </node>

    <!-- V2X TX BSM via MQTT (PC → Cloud V2N). mqtt_server arg 로 test/prod 전환 -->
    <node name="mqtt_bsm_tx_node" type="mqtt_bsm_tx_node" pkg="siheung_v2x"
          respawn="true" output="screen">
        <param name="broker_host"  value="$(arg mqtt_host)" />
        <param name="broker_port"  value="$(arg mqtt_port)" />
        <param name="username"     value="$(arg mqtt_user)" />
        <param name="password"     value="$(arg mqtt_pass)" />
        <param name="topic"        value="V2N/1321103202/bsm" />
        <param name="client_id"    value="" />
        <param name="keepalive"    value="60" />
        <param name="qos"          value="0" />
        <param name="retain"       value="false" />
        <param name="vehicle_id"   value="EV01" />
        <param name="publish_rate" value="10.0" />
        <param name="verbose_first_msg" value="true" />
    </node>
</launch>
